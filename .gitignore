# OctoSlave runtime data
research/
octoslave_deploy/
tasks/
*.log
# user config lives in ~/.octoslave/ — never commit API keys

# Secrets / credentials (extra safety net)
.env
.env.*
*.pem
*.key
config.json
secrets.json
credentials.json

debug
uv.lock
.claude
.octo

# Frontend (Vite/React) — ignore deps & dev cache; the built Lab UI in
# octoslave/web/lab_static/ IS committed so pip/installer users need no Node.
frontend/node_modules/
frontend/.vite/
frontend/dist/
